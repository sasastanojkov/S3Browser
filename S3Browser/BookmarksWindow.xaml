<Window x:Class="S3Browser.BookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bookmarks" 
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Saved Bookmarks" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Quick access to your favorite S3 locations" 
                       Foreground="Gray"
                       FontSize="12"/>
        </StackPanel>

        <!-- Bookmarks List -->
        <Border Grid.Row="1" 
                BorderBrush="LightGray" 
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="📌" 
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="No bookmarks yet" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Navigate to a folder and click the bookmark button to save it" 
                               FontSize="12"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300"/>
                </StackPanel>

                <!-- Bookmarks DataGrid -->
                <DataGrid x:Name="BookmarksDataGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          BorderThickness="0"
                          MouseDoubleClick="BookmarksDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" 
                                            Binding="{Binding Name}" 
                                            Width="*"
                                            MinWidth="120"/>
                        <DataGridTextColumn Header="S3 Path" 
                                            Binding="{Binding S3Path}" 
                                            Width="2*"
                                            MinWidth="200"/>
                        <DataGridCheckBoxColumn Header="Public" 
                                                Binding="{Binding IsPublic, Mode=OneWay}" 
                                                Width="80"
                                                IsReadOnly="True"/>
                        <DataGridTextColumn Header="Created" 
                                            Binding="{Binding CreatedDate, StringFormat='yyyy-MM-dd HH:mm'}" 
                                            Width="140"/>
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Go" 
                                                Width="50"
                                                Height="24"
                                                Margin="0,0,5,0"
                                                Background="#FF4CAF50"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="GoToBookmark_Click"
                                                ToolTip="Navigate to this bookmark"/>
                                        <Button Content="✕" 
                                                Width="24"
                                                Height="24"
                                                Background="#FFFF5252"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="DeleteBookmark_Click"
                                                ToolTip="Delete this bookmark"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Clear All" 
                    Width="100" 
                    Height="32"
                    Click="ClearAll_Click" 
                    Margin="0,0,10,0"
                    ToolTip="Remove all bookmarks"
                    x:Name="ClearAllButton"/>
            <Button Content="Close" 
                    Width="80" 
                    Height="32"
                    IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
