<Window x:Class="S3Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:S3Browser"
        mc:Ignorable="d"
        Title="S3 Browser" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="White">
            <MenuItem Header="_File">
                <MenuItem x:Name="ChangeProfileMenuItem"
                          Header="Change Profile..."
                          Click="ChangeProfileButton_Click"
                          ToolTip="Switch between profiles or anonymous mode">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="SettingsMenuItem"
                          Header="_Settings..."
                          Click="SettingsMenuItem_Click"
                          ToolTip="Configure application settings">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Bookmarks">
                <MenuItem x:Name="ViewBookmarksMenuItem"
                          Header="_View Bookmarks..."
                          Click="ViewBookmarksMenuItem_Click"
                          ToolTip="View and manage saved bookmarks">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="AddBookmarkMenuItem"
                          Header="_Add Current Location"
                          Click="AddBookmarkMenuItem_Click"
                          IsEnabled="False"
                          ToolTip="Save current location as a bookmark">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE735;"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1" 
                   x:Name="TitleTextBlock"
                   Text="AWS S3 Buckets" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="10" HorizontalAlignment="Center"/>

        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="S3 Path:" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>
            
            <TextBox Grid.Column="1" 
                     x:Name="S3PathTextBox"
                     VerticalAlignment="Center"
                     Padding="5"
                     FontSize="12"
                     ToolTip="Enter S3 path (e.g., s3://bucket-name/path/to/folder). Works with both private and public buckets."
                     KeyDown="S3PathTextBox_KeyDown"/>
            
            <Button Grid.Column="2" 
                    Content="Go" 
                    Width="60" 
                    Height="28"
                    Margin="10,0,0,0"
                    Click="GoButton_Click"/>
            
            <Button Grid.Column="3"
                    x:Name="BookmarkButton"
                    Width="28" 
                    Height="28"
                    Margin="10,0,0,0"
                    Click="BookmarkButton_Click"
                    Visibility="Collapsed"
                    ToolTip="Add current location to bookmarks"
                    Background="#FFFFC107"
                    BorderThickness="0">
                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           Text="&#xE734;" 
                           FontSize="16"
                           Foreground="White"/>
            </Button>
            
            <Button Grid.Column="4"
                    x:Name="HomeButton"
                    Width="80" 
                    Height="28"
                    Margin="10,0,0,0"
                    Click="HomeButton_Click"
                    Visibility="Collapsed"
                    ToolTip="Return to buckets list">
                <TextBlock>
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"/>
                    <Run Text=" Home"/>
                </TextBlock>
            </Button>
            
            <Button Grid.Column="5"
                    x:Name="DownloadAllButton"
                    Width="120" 
                    Height="28"
                    Margin="10,0,0,0"
                    Background="#FF9C27B0"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="DownloadAllButton_Click"
                    ToolTip="Recursively download all files in this folder, preserving folder hierarchy">
                <TextBlock>
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE896;"/>
                    <Run Text=" Download All"/>
                </TextBlock>
            </Button>
        </Grid>

        <Grid Grid.Row="3" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="ReadAllParquetButton"
                    Height="35"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="ReadAllParquetButton_Click"
                    ToolTip="Query all .parquet files in this folder using DuckDB wildcard">
                <TextBlock FontSize="13" FontWeight="SemiBold">
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"/>
                    <Run Text=" Read All Parquet Files"/>
                </TextBlock>
            </Button>

            <Button Grid.Column="2"
                    x:Name="ReadAllParquetAsTableButton"
                    Height="35"
                    Background="#FFFF9800"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="ReadAllParquetAsTableButton_Click"
                    ToolTip="Load all .parquet files into a DuckDB table for faster querying (max 500MB)">
                <TextBlock FontSize="13" FontWeight="SemiBold">
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/>
                    <Run Text=" Read All As Table"/>
                </TextBlock>
            </Button>

            <Button Grid.Column="4"
                    x:Name="WriteQueryButton"
                    Height="35"
                    Background="#FF2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="WriteQueryButton_Click"
                    ToolTip="Write and execute a custom SQL query against parquet files">
                <TextBlock FontSize="13" FontWeight="SemiBold">
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"/>
                    <Run Text=" Write Custom Query"/>
                </TextBlock>
            </Button>
        </Grid>

        <DataGrid Grid.Row="4" 
                  x:Name="FilesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  MouseDoubleClick="FilesDataGrid_MouseDoubleClick"
                  PreviewKeyDown="FilesDataGrid_KeyDown"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
                <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="150"/>
                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Download Button (shown when not downloading and file size > 0) -->
                                <Button Tag="{Binding}"
                                        Click="DownloadFile_Click"
                                        Width="100"
                                        Height="20"
                                        Background="#FF9C27B0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="10"
                                        Padding="2"
                                        Cursor="Hand"
                                        ToolTip="Download this file">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Download" FontSize="9"/>
                                        </StackPanel>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Type}" Value="File"/>
                                                        <Condition Binding="{Binding IsDownloading}" Value="False"/>
                                                        <Condition Binding="{Binding HasContent}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Progress Bar and Cancel Button (shown when downloading) -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ProgressBar Grid.Column="0"
                                                 Value="{Binding DownloadProgress}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="20"
                                                 Margin="0,0,2,0"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="X"
                                            Tag="{Binding}"
                                            Click="DownloadFile_Click"
                                            Width="20"
                                            Height="20"
                                            Background="#FFFF5252"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip="Cancel download"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Height="25" Background="#FFF0F0F0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="Ready" 
                               Margin="5,0,10,0"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="StatusProgressBar"
                                 Width="150"
                                 Height="16"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="ItemCountTextBlock" 
                           Text="" 
                           Margin="5,0,5,0"
                           VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
