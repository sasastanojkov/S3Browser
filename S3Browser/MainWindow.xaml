<Window x:Class="S3Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:S3Browser"
        mc:Ignorable="d"
        Title="S3 Browser" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   x:Name="TitleTextBlock"
                   Text="AWS S3 Buckets" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="10" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="S3 Path:" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>
            
            <TextBox Grid.Column="1" 
                     x:Name="S3PathTextBox"
                     VerticalAlignment="Center"
                     Padding="5"
                     FontSize="12"
                     ToolTip="Enter S3 path (e.g., s3://bucket-name/path/to/folder). Works with both private and public buckets."
                     KeyDown="S3PathTextBox_KeyDown"/>
            
            <Button Grid.Column="2" 
                    Content="Go" 
                    Width="60" 
                    Height="28"
                    Margin="10,0,0,0"
                    Click="GoButton_Click"/>
            
            <Button Grid.Column="3"
                    x:Name="HomeButton"
                    Content="🏠 Home" 
                    Width="80" 
                    Height="28"
                    Margin="10,0,0,0"
                    Click="HomeButton_Click"
                    Visibility="Collapsed"
                    ToolTip="Return to buckets list"/>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="ReadAllParquetButton"
                    Content="📊 Read All Parquet Files"
                    Height="35"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="ReadAllParquetButton_Click"
                    ToolTip="Query all .parquet files in this folder using DuckDB wildcard"/>

            <Button Grid.Column="2"
                    x:Name="WriteQueryButton"
                    Content="✏️ Write Custom Query"
                    Height="35"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#FF2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="WriteQueryButton_Click"
                    ToolTip="Write and execute a custom SQL query against parquet files"/>
        </Grid>

        <DataGrid Grid.Row="3" 
                  x:Name="FilesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  MouseDoubleClick="FilesDataGrid_MouseDoubleClick"
                  PreviewKeyDown="FilesDataGrid_KeyDown"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
                <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Height="25" Background="#FFF0F0F0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="Ready" 
                               Margin="5,0,10,0"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="StatusProgressBar"
                                 Width="150"
                                 Height="16"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="ItemCountTextBlock" 
                           Text="" 
                           Margin="5,0,5,0"
                           VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
