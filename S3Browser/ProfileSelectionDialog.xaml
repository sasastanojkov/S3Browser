<Window x:Class="S3Browser.ProfileSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select AWS Profile" 
        Height="250" 
        Width="412"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20,20,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="AWS Profile Selection" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="Please select an AWS profile to use:" 
                   Margin="0,0,0,10"/>

        <ComboBox Grid.Row="2" 
                  x:Name="ProfileComboBox"
                  Padding="5"
                  FontSize="14"
                  Margin="0,0,0,10"
                  IsEditable="True"/>

        <Button Grid.Row="3"
                x:Name="AnonymousButton"
                Content="🌐 Anonymous Access (Public Buckets Only)"
                Height="35"
                Margin="0,0,0,10"
                Background="#FF2196F3"
                Foreground="White"
                FontWeight="SemiBold"
                BorderThickness="0"
                Click="AnonymousButton_Click"
                ToolTip="Browse public S3 buckets without AWS credentials"/>

        <TextBlock Grid.Row="4" 
                   Text="Make sure you have run 'aws sso login --profile [profile-name]' before continuing."
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="11"
                   Margin="0,5,0,10"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,0,0,0">
            <Button Content="OK" 
                    Width="80" 
                    Height="30" 
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Content="Cancel" 
                    Width="80" 
                    Height="30"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
