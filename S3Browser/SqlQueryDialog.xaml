<Window x:Class="S3Browser.SqlQueryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SQL Query Editor" 
        Height="550" 
        Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Border Grid.Row="0"
                Background="#FF2196F3"
                Padding="15">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                           Text="SQL Query Editor"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="Write custom SQL queries using DuckDB syntax"
                           FontSize="12"
                           Foreground="White"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Info Section -->
        <Border Grid.Row="1"
                x:Name="InfoBorder"
                Background="#FFFAFAFA"
                BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,0,1"
                Padding="15"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="InfoTextBlock"
                           TextWrapping="Wrap" 
                           FontSize="12">
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Query Editor Section -->
        <Border Grid.Row="2"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                Margin="15,15,15,10">
            <Grid>
                <TextBox x:Name="QueryTextBox"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10"
                         Background="White"
                         BorderThickness="0"/>
                <TextBlock x:Name="PlaceholderTextBlock"
                           Text="Enter your SQL query here (Ctrl+Enter to execute)..."
                           FontSize="12"
                           Foreground="LightGray"
                           Margin="15,15,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QueryTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Message Display -->
        <Border x:Name="MessageBorder"
                Grid.Row="3"
                BorderThickness="1"
                Padding="10"
                Margin="15,0,15,10"
                Visibility="Collapsed"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageTextBox"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="CloseMessageButton_Click"/>
            </Grid>
        </Border>

        <!-- Buttons Section -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="15">
            <Button x:Name="ExecuteButton"
                    Content="Execute (Ctrl+Enter)"
                    Width="150"
                    Height="35"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Margin="0,0,10,0"
                    Click="ExecuteButton_Click"
                    IsDefault="True"/>
            <Button x:Name="CancelButton"
                    Content="Close"
                    Width="100"
                    Height="35"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              Background="#80000000"
              Visibility="Collapsed">
            <Border Background="White"
                    CornerRadius="8"
                    Padding="30,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 Height="20"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoadingMessageTextBlock"
                               Text="Executing query..."
                               FontSize="14"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FF333333"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
