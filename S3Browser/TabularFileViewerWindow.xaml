<local:DataViewerWindowBase x:Class="S3Browser.TabularFileViewerWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:S3Browser"
mc:Ignorable="d"
Title="Tabular File Viewer" 
Height="600" 
Width="1000"
WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   x:Name="FileNameTextBlock"
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="10,10,10,5"
                   TextWrapping="Wrap"/>

        <!-- Clickable S3 Path Display -->
        <Border Grid.Row="1"
                x:Name="FilePathBorder"
                Background="Transparent"
                Margin="10,0,10,5"
                Cursor="Hand"
                ToolTip="Click to copy S3 path to clipboard"
                MouseLeftButtonDown="FilePathBorder_MouseLeftButtonDown">
            <TextBlock x:Name="FilePathTextBlock"
                       FontSize="12"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </Border>

        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      x:Name="HasHeaderCheckBox"
                      Content="File has header"
                      VerticalAlignment="Center"
                      Margin="0,0,20,0"
                      IsChecked="False"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Limit: " 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="RowLimitComboBox"
                          Width="150"
                          SelectedIndex="0">
                    <ComboBoxItem Content="10 rows" Tag="10"/>
                    <ComboBoxItem Content="100 rows" Tag="100"/>
                    <ComboBoxItem Content="1,000 rows" Tag="1000"/>
                    <ComboBoxItem Content="10,000 rows" Tag="10000"/>
                    <ComboBoxItem Content="100,000 rows" Tag="100000"/>
                    <ComboBoxItem Content="All rows" Tag="-1"/>
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="3"
                    Content="DDL Query"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Background="#FFFF9800"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="DdlQueryButton_Click"
                    ToolTip="Create tables and views using DDL queries"/>

            <Button Grid.Column="4"
                    Content="Edit Query"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="EditQueryButton_Click"
                    ToolTip="Edit SQL query"/>

            <Button Grid.Column="5"
                    Content="Expand All"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="ExpandAllButton_Click"
                    ToolTip="Show all data in detailed view"/>

            <Button Grid.Column="6"
                    Content="Reload"
                    Width="100"
                    Height="30"
                    Click="ReloadButton_Click"/>
        </Grid>

        <Border Grid.Row="3" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Margin="10,0,10,10">
            <Grid>
                <DataGrid x:Name="ResultsDataGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          AlternatingRowBackground="WhiteSmoke"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"/>
                
                <!-- Loading Overlay -->
                <Grid x:Name="LoadingOverlay" 
                      Background="#CC000000" 
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" 
                                     Width="200" 
                                     Height="20" 
                                     Margin="0,0,0,10"/>
                        <TextBlock x:Name="LoadingMessageTextBlock"
                                   Text="Loading data..." 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="10">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready to load data"
                       Foreground="Gray"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            <Button Content="Close" 
                    Width="80" 
                    Height="30"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</local:DataViewerWindowBase>
